# Copy this file to .env, edit local paths, then run:
#   set -a; source .env; set +a

# Optional: local pi05_libero checkpoint root containing params/ and assets/.
# If unset, OpenPI uses gs://openpi-assets/checkpoints/pi05_libero.
OPENPI_PI05_LIBERO_CHECKPOINT=/absolute/path/to/pi05_libero

# Optional: override the default converted dataset location.
OPENPI_LIBERO_DATA_ROOT=data/lerobot/local/libero

# Optional: only needed when LIBERO is not in either supported third_party layout.
# OPENPI_LIBERO_ROOT=/absolute/path/to/LIBERO

# Recommended headless MuJoCo settings. MUJOCO_EGL_DEVICE_ID is a visible-device index.
MUJOCO_GL=egl
MUJOCO_EGL_DEVICE_ID=0

# Avoid JAX reserving nearly all GPU memory before training/inference.
XLA_PYTHON_CLIENT_PREALLOCATE=false
